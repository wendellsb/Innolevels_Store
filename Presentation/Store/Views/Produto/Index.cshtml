@model List<Domain.Entities.Produto>
@{
  Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts {
  <script src="~/js/produto.js"></script>
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">
    <i class="fa-solid fa-boxes-packing me-2 text-black"></i> Cadastro de Produtos
  </h2>
  <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalAdicionarProduto">
  <i class="bi bi-plus-circle"></i> Adicionar novo Produto
  </button>
</div>

<div class="card card_sti mt-3 mb-2">
  <div class="card-body card-body_sti content-grid">
    @Html.Partial("Partial/PVGrid", Model)
  </div>
</div>

@Html.Partial("Partial/PVModal")
